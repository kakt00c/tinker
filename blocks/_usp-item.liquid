

{%- doc -%}
  Renders a single USP (unique selling point): an icon paired with one line of text.

  Used exclusively by the `usp-bar` section, which owns the icon size, text size and
  layout for every item so the row stays visually consistent.
{%- enddoc -%}

{% liquid
  assign block_settings = block.settings
  assign icon_class = 'usp-item__icon usp-item-' | append: block.id
  assign icon_size = section.settings.icon_size | default: 24
%}

{% if block_settings.icon_color != blank %}
  {% style %}
    .usp-item-{{ block.id }} {
      color: {{ block_settings.icon_color }};
    }
  {% endstyle %}
{% endif %}

<li class="usp-item" {{ block.shopify_attributes }}>
  {%- if block_settings.icon != 'none' or block_settings.image_upload != blank -%}
    <span class="usp-item__icon-wrapper">
      {% render 'icon-or-image',
        icon: block_settings.icon,
        image_upload: block_settings.image_upload,
        width: icon_size,
        class_name: icon_class
      %}
    </span>
  {%- endif -%}

  {%- if block_settings.text != blank -%}
    <span class="usp-item__text">{{ block_settings.text }}</span>
  {%- endif -%}
</li>

{% stylesheet %}
  .usp-item {
    display: flex;
    align-items: center;
    gap: var(--usp-icon-gap);
    min-width: 0;
  }

  .usp-item__icon-wrapper {
    display: flex;
    flex-shrink: 0;
    align-items: center;
  }

  .usp-item__icon {
    height: auto;
  }

  .usp-item__text {
    text-wrap: pretty;
  }

  .usp-item__text > p {
    margin: 0;
  }
{% endstylesheet %}

