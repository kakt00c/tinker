{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{% style %}
  .usps-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    justify-content: {{ section.settings.alignment }};
    gap: {{ section.settings.gap }}px;
  }
  .usps-{{ section.id }} .usp-item {
    display: flex;
    align-items: center;
    gap: 16px;
    flex: 1 1 200px;
    max-width: 320px;
  }
  .usps-{{ section.id }} .usp-icon {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: currentColor;
  }
  .usps-{{ section.id }} .usp-icon svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .usps-{{ section.id }} .usp-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .usps-{{ section.id }} .usp-text-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .usps-{{ section.id }} .usp-heading {
    font-weight: 600;
    line-height: 1.2;
    margin: 0;
    font-size: 1rem;
  }
  .usps-{{ section.id }} .usp-text {
    line-height: 1.4;
    margin: 0;
    opacity: 0.8;
    font-size: 0.9rem;
  }

  @media screen and (max-width: 749px) {
    .usps-{{ section.id }} {
      flex-direction: column;
      align-items: flex-start;
      padding: 0 16px;
    }
    .usps-{{ section.id }} .usp-item {
      width: 100%;
      max-width: 100%;
      justify-content: flex-start;
    }
  }
{% endstyle %}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>
<div class="section section--{{ section.settings.section_width }} spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}" style="{% render 'spacing-padding', settings: section.settings %}">
  <div class="usps-{{ section.id }}">
    {% for block in section.blocks %}
      <div class="usp-item" {{ block.shopify_attributes }}>
        {% if block.settings.icon_svg != blank or block.settings.icon_image != blank %}
          <div class="usp-icon">
            {% if block.settings.icon_image != blank %}
              {{ block.settings.icon_image | image_url: width: section.settings.icon_size | image_tag: loading: 'lazy' }}
            {% elsif block.settings.icon_svg != blank %}
              {{ block.settings.icon_svg }}
            {% endif %}
          </div>
        {% endif %}
        <div class="usp-text-content">
          {% if block.settings.heading != blank %}
            <div class="usp-heading">{{ block.settings.heading }}</div>
          {% endif %}
          {% if block.settings.text != blank %}
            <div class="usp-text">{{ block.settings.text }}</div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "USPs",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Desktop alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "space-between",
          "label": "Space between"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Spacing between USPs",
      "min": 10,
      "max": 60,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 20,
      "max": 80,
      "step": 2,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 36,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Free shipping"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "On all orders over $50"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image"
        },
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Custom SVG Icon",
          "info": "Paste SVG code here"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "USPs",
      "blocks": [
        {
          "type": "usp",
          "settings": {
            "heading": "Fast dispatch",
            "text": "Within <48 hours for orders placed before 2:00 PM"
          }
        },
        {
          "type": "usp",
          "settings": {
            "heading": "Free returns",
            "text": "For up to 100 days from receipt of goods"
          }
        },
        {
          "type": "usp",
          "settings": {
            "heading": "Wide variety",
            "text": "A wide variety of patterns to choose from, something for everyone"
          }
        },
        {
          "type": "usp",
          "settings": {
            "heading": "Free shipping",
            "text": "On orders over 999 CZK"
          }
        }
      ]
    }
  ]
}
{% endschema %}
